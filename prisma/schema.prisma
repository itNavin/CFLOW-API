generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  lecturer
  staff
  SUPER_ADMIN
}

enum AdvisorRole {
  ADVISOR
  CO_ADVISOR
}

enum ClassProgram {
  CS
  DSI
  BOTH
}

enum SubmissionStatus {
  SUBMITTED
  REJECTED
  APPROVED_WITH_FEEDBACK
  FINAL
}

enum EntityType {
  ANNOUNCEMENT
  ASSIGNMENT
  SUBMISSION
  GROUP
}

enum UserStatus {
  ACTIVE
  RESIGNED
  RETIRED
  GRADUATED
}

model User {
  id                   String         @id
  name                 String         @unique
  email                String         @unique
  password             String?       
  role                 Role
  program              ClassProgram
  status               UserStatus     @default(ACTIVE)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)

  createdClasses       Course[]       @relation("CreatedByUser")
  classMemberships     CourseMember[] @relation("UserCourseMemberships")
  createdAnnouncements Announcement[]
  uploadedFiles        File[]
  activityLogs         ActivityLog[]
  passwordResetTokens  PasswordResetToken[]
}

model Course {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  program       ClassProgram
  createdById   String
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  createdBy     User            @relation("CreatedByUser", fields: [createdById], references: [id])
  members       CourseMember[]
  groups        Group[]
  assignments   Assignment[]    @relation(name: "CourseAssignments")
  announcements Announcement[]
  files         File[]
}

model CourseMember {
  id             String  @id @default(uuid()) @db.Uuid
  courseId       String  @db.Uuid
  userId         String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  course         Course  @relation(fields: [courseId], references: [id])
  user           User    @relation("UserCourseMemberships", fields: [userId], references: [id])

  groupMembers   GroupMember[]
  groupAdvisors  GroupAdvisor[]

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
}

model Group {
  id          String  @id @default(uuid()) @db.Uuid
  courseId    String  @db.Uuid
  codeNumber  String?
  projectName String
  productName String?
  company     String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  course             Course              @relation(fields: [courseId], references: [id])
  members            GroupMember[]
  advisors           GroupAdvisor[]
  submissions        Submission[]        @relation(name: "GroupSubmissions")
  assignmentDueDates AssignmentDueDate[]

  @@unique([courseId, codeNumber])
  @@unique([courseId, projectName])
}

model GroupMember {
  id             String @id @default(uuid()) @db.Uuid
  workRole       String?
  courseMemberId String @db.Uuid
  groupId        String @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  courseMember CourseMember @relation(fields: [courseMemberId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])

  @@unique([groupId, courseMemberId])
}

model GroupAdvisor {
  id             String      @id @default(uuid()) @db.Uuid
  courseMemberId String      @db.Uuid
  advisorRole    AdvisorRole
  groupId        String      @db.Uuid
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  courseMember CourseMember @relation(fields: [courseMemberId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])

  @@unique([groupId, courseMemberId, advisorRole])
}

model Assignment {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  dueDate     DateTime  @db.Timestamptz(3)
  endDate     DateTime  @db.Timestamptz(3)
  schedule    DateTime @db.Timestamptz(3)
  courseId    String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  course             Course              @relation(fields: [courseId], references: [id], name: "CourseAssignments")
  deliverables       Deliverable[]
  submissions        Submission[]
  assignmentDueDates AssignmentDueDate[]
  assignmentFiles    AssignmentFile[]
}

model AssignmentFile {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  name        String
  fileUrl      String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@index([assignmentId])
}

model AssignmentDueDate {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  groupId      String   @db.Uuid
  dueDate      DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])

  @@unique([assignmentId, groupId])
  @@index([assignmentId])
  @@index([groupId])
}

model Deliverable {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  assignmentId String  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  assignment       Assignment        @relation(fields: [assignmentId], references: [id])
  allowedFileTypes AllowedFileType[]
  submissionFiles  SubmissionFile[]
  feedbackFiles    FeedbackFile[]
}

model AllowedFileType {
  id            String @id @default(uuid()) @db.Uuid
  mime          String
  type          String
  deliverableId String @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@unique([deliverableId, mime])
  @@index([deliverableId])
}

model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  submittedAt  DateTime         @default(now()) @db.Timestamptz(3)
  assignmentId String           @db.Uuid
  groupId      String           @db.Uuid
  comment      String?
  status       SubmissionStatus  @default(SUBMITTED)
  missed       Boolean           @default(false)
  version      Int               @default(1)

  assignment      Assignment   @relation(fields: [assignmentId], references: [id])
  group           Group        @relation(fields: [groupId], references: [id], name: "GroupSubmissions")
  feedbacks       Feedback[]
  submissionFiles SubmissionFile[]
}

model SubmissionFile {
  id            String   @id @default(uuid()) @db.Uuid
  submissionId  String   @db.Uuid
  deliverableId String   @db.Uuid
  name          String
  fileUrl       String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  submission  Submission  @relation(fields: [submissionId], references: [id])
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
}

model Feedback {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @db.Uuid
  comment      String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  submission    Submission     @relation(fields: [submissionId], references: [id])
  feedbackFiles FeedbackFile[]
}

model FeedbackFile {
  id            String   @id @default(uuid()) @db.Uuid
  feedbackId    String   @db.Uuid
  deliverableId String   @db.Uuid
  name          String
  fileUrl       String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  feedback    Feedback    @relation(fields: [feedbackId], references: [id])
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@index([feedbackId])
  @@index([deliverableId])
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  courseId    String    @db.Uuid
  name        String
  description String?
  schedule    DateTime @db.Timestamptz(3)
  createById  String
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  createdBy User   @relation(fields: [createById], references: [id])
  course    Course @relation(fields: [courseId], references: [id])
  files     File[]
}

model File {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  filepath       String
  createdById    String
  courseId       String   @db.Uuid
  announcementId String?  @db.Uuid
  uploadAt       DateTime @default(now()) @db.Timestamptz(3)

  createdBy    User         @relation(fields: [createdById], references: [id])
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([announcementId])
}

model ActivityLog {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      
  title          String
  description    String
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  user           User        @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}
