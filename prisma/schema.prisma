generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
  // binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADVISOR
  ADMIN
  SUPER_ADMIN
}

enum AdvisorRole {
  ADVISOR
  CO_ADVISOR
}

enum ClassProgram {
  CS
  DSI
}

enum SubmissionStatus {
  SUBMITTED
  REJECTED
  APPROVED_WITH_FEEDBACK
  FINAL
}

enum EntityType {
  ANNOUNCEMENT
  ASSIGNMENT
  SUBMISSION
  GROUP
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  prefix       String
  name         String
  surname      String
  role         Role
  createdAt    DateTime @default(now())

  createdClasses       Course[]       @relation("CreatedByUser")
  classMemberships     CourseMember[]
  createdAnnouncements Announcement[]
  uploadedFiles        File[]
}

model Course {
  id          Int          @id @default(autoincrement())
  name        String
  description String
  program     ClassProgram
  createdById Int
  createdAt   DateTime     @default(now())

  createdBy     User                @relation("CreatedByUser", fields: [createdById], references: [id])
  members       CourseMember[]
  groups        Group[]
  assignments   Assignment[]        @relation(name: "CourseAssignments")
  announcements Announcement[]
  activityLogs  CourseActivityLog[]
}

model CourseMember {
  id       Int @id @default(autoincrement())
  courseId Int
  userId   Int

  course        Course              @relation(fields: [courseId], references: [id])
  user          User                @relation(fields: [userId], references: [id])
  groupMembers  GroupMember[]
  groupAdvisors GroupAdvisor[]
  activityLogs  CourseActivityLog[]
}

model Group {
  id          Int     @id @default(autoincrement())
  courseId    Int
  codeNumber  String? // admin can type "0001" manually
  projectName String
  productName String?
  company     String?

  course             Course              @relation(fields: [courseId], references: [id])
  members            GroupMember[]
  advisors           GroupAdvisor[]
  submissions        Submission[]        @relation(name: "GroupSubmissions")
  assignmentDueDates AssignmentDueDate[]

  @@unique([courseId, codeNumber])
}

model GroupMember {
  id             Int    @id @default(autoincrement())
  workRole       String
  courseMemberId Int
  groupId        Int

  courseMember CourseMember @relation(fields: [courseMemberId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])
}

model GroupAdvisor {
  id             Int         @id @default(autoincrement())
  courseMemberId Int
  advisorRole    AdvisorRole
  groupId        Int

  courseMember CourseMember @relation(fields: [courseMemberId], references: [id])
  group        Group        @relation(fields: [groupId], references: [id])
}

model Assignment {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  endDate     DateTime
  schedule    DateTime
  courseId    Int

  course             Course              @relation(fields: [courseId], references: [id], name: "CourseAssignments")
  deliverables       Deliverable[]
  submissions        Submission[]
  assignmentDueDates AssignmentDueDate[]
}

model AssignmentDueDate {
  id           Int      @id @default(autoincrement())
  assignmentId Int
  groupId      Int
  dueDate      DateTime
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  group      Group      @relation(fields: [groupId], references: [id])

  @@unique([assignmentId, groupId])
  @@index([assignmentId])
  @@index([groupId])
}

model Deliverable {
  id           Int    @id @default(autoincrement())
  name         String
  assignmentId Int

  assignment       Assignment        @relation(fields: [assignmentId], references: [id])
  allowedFileTypes AllowedFileType[]
  submissionFiles  SubmissionFile[]
  feedbackFiles    FeedbackFile[]
}

model AllowedFileType {
  id            Int    @id @default(autoincrement())
  mime          String? // e.g. "application/pdf"
  type          String // e.g. "PDF" or "Word Document"
  deliverableId Int

  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@unique([deliverableId, mime])
  @@index([deliverableId])
}



model Submission {
  id           Int              @id @default(autoincrement())
  submittedAt  DateTime?
  assignmentId Int
  groupId      Int
  comment      String?
  status       SubmissionStatus @default(SUBMITTED)
  missed       Boolean          @default(false)
  version      Int              @default(1)

  assignment      Assignment       @relation(fields: [assignmentId], references: [id])
  group           Group            @relation(fields: [groupId], references: [id], name: "GroupSubmissions")
  feedbacks       Feedback[]
  submissionFiles SubmissionFile[]
}

model SubmissionFile {
  id            Int      @id @default(autoincrement())
  submissionId  Int
  deliverableId Int
  fileUrl       String[]

  submission  Submission  @relation(fields: [submissionId], references: [id])
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])
}

model Feedback {
  id           Int      @id @default(autoincrement())
  submissionId Int
  comment      String
  createdAt    DateTime @default(now())

  submission    Submission     @relation(fields: [submissionId], references: [id])
  feedbackFiles FeedbackFile[]
}

model FeedbackFile {
  id            Int      @id @default(autoincrement())
  feedbackId    Int
  deliverableId Int
  fileUrl       String[]

  feedback    Feedback    @relation(fields: [feedbackId], references: [id])
  deliverable Deliverable @relation(fields: [deliverableId], references: [id])

  @@index([feedbackId])
  @@index([deliverableId])
}

model Announcement {
  id          Int      @id @default(autoincrement())
  courseId    Int
  name        String
  description String
  createdAt   DateTime @default(now())
  schedule    DateTime
  createById  Int

  createdBy User   @relation(fields: [createById], references: [id])
  course    Course @relation(fields: [courseId], references: [id])
  files     File[]
}

model File {
  id             Int      @id @default(autoincrement())
  name           String
  filepath       String
  uploadAt       DateTime @default(now())
  uploadById     Int
  announcementId Int?

  uploadBy     User          @relation(fields: [uploadById], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([announcementId])
}

model CourseActivityLog {
  id             Int        @id @default(autoincrement())
  courseId       Int
  courseMemberId Int
  action         String
  entityType     EntityType
  entityId       Int
  createdAt      DateTime   @default(now())

  course       Course       @relation(fields: [courseId], references: [id])
  courseMember CourseMember @relation(fields: [courseMemberId], references: [id])

  @@index([courseId, entityType, entityId])
}
